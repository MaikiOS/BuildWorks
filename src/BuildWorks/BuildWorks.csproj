<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>BuildWorks</AssemblyName>
    <RootNamespace>OstrixMods.BuildWorks</RootNamespace>
<Version>0.19.274</Version>
<AssemblyVersion>0.19.274.0</AssemblyVersion>
<FileVersion>0.19.274.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\bin\</OutputPath>
    <DefineConstants Condition="'$(BuildWorksTestStand)' == 'true'">$(DefineConstants);BUILDWORKS_TEST_STAND</DefineConstants>
    <DefineConstants Condition="'$(BuildWorksFogOrdinaryBudget)' == 'true'">$(DefineConstants);BUILDWORKS_FOG_ORDINARY_BUDGET</DefineConstants>
    <DefineConstants Condition="'$(BuildWorksFogPageReuseCandidate)' == 'true'">$(DefineConstants);BUILDWORKS_FOG_PAGE_REUSE_CANDIDATE</DefineConstants>
    <DefineConstants Condition="'$(BuildWorksFogGpuResidentCandidate)' == 'true' and '$(BuildWorksTestStand)' == 'true'">$(DefineConstants);BUILDWORKS_FOG_GPU_RESIDENT_CANDIDATE</DefineConstants>
    <OutputPath Condition="'$(BuildWorksTestStand)' == 'true'">$(MSBuildThisFileDirectory)..\..\artifacts\test-stand-bin\</OutputPath>
    <ProfileRoot Condition="'$(ProfileRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</ProfileRoot>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManagedDir>
  </PropertyGroup>

  <Target Name="RequireFogGpuCandidateTestStand" BeforeTargets="CoreCompile"
          Condition="'$(BuildWorksFogGpuResidentCandidate)' == 'true' and '$(BuildWorksTestStand)' != 'true'">
    <Error Text="BuildWorksFogGpuResidentCandidate requires BuildWorksTestStand=true." />
  </Target>

  <Target Name="RequireFogOrdinaryBudgetTestStand" BeforeTargets="CoreCompile"
          Condition="'$(BuildWorksFogOrdinaryBudget)' == 'true'">
    <Error Condition="'$(BuildWorksTestStand)' != 'true'" Text="BuildWorksFogOrdinaryBudget requires BuildWorksTestStand=true." />
    <Error Condition="'$(BuildWorksFogGpuResidentCandidate)' == 'true' or '$(BuildWorksFogPageReuseCandidate)' == 'true'"
           Text="The ordinary budget probe requires production allocation without residency/page-reuse candidates." />
  </Target>

  <ItemGroup>
    <Reference Include="Unity.InputSystem" Condition="'$(BuildWorksTestStand)' == 'true'">
      <HintPath>$(ValheimManagedDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.JSONSerializeModule" Condition="'$(BuildWorksTestStand)' == 'true'">
      <HintPath>$(ValheimManagedDir)\UnityEngine.JSONSerializeModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule" Condition="'$(BuildWorksTestStand)' == 'true'">
      <HintPath>$(ValheimManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.IO.Compression" />
    <ProjectReference Include="..\BuildWorks.Geometry\BuildWorks.Geometry.csproj" />
    <Compile Remove="AdaptiveGablePiece.cs" />
    <EmbeddedResource Include="Assets\BlueprintEditorIcons\*.png" Exclude="Assets\BlueprintEditorIcons\snap-corner.png;Assets\BlueprintEditorIcons\snap-midpoint.png;Assets\BlueprintEditorIcons\snap-centre.png;Assets\BlueprintEditorIcons\snap-pin.png;Assets\BlueprintEditorIcons\snap-active.png" />
    <EmbeddedResource Include="Translations\*.tsv" />
    <EmbeddedResource Include="Assets\FogGhostRuntime\buildworks-fog-v11" LogicalName="BuildWorks.FogGhostV11" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ProfileRoot)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ProfileRoot)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ValheimManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Splatform">
      <HintPath>$(ValheimManagedDir)\Splatform.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>$(ValheimManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

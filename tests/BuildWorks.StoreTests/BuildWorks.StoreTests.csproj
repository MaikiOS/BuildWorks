<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ProfileRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</ProfileRoot>
    <ValheimManagedDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim\valheim_Data\Managed</ValheimManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\fixtures\contents\*.buildworks.json" Link="fixtures\contents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\planbuild\27-planbuild-snap-tail.blueprint" Link="fixtures\planbuild\27-planbuild-snap-tail.blueprint" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\planbuild\28-planbuild-hashed-mounts.blueprint" Link="fixtures\planbuild\28-planbuild-hashed-mounts.blueprint" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\fixtures\planbuild\29-planbuild-storage106.blueprint" Link="fixtures\planbuild\29-planbuild-storage106.blueprint" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\BuildWorks.Geometry\BuildWorks.Geometry.csproj" />
    <Compile Include="..\..\src\BuildWorks\CompositeBlueprintStore.cs" Link="CompositeBlueprintStore.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintConstructionProjectStore.cs" Link="BlueprintConstructionProjectStore.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintConstructionPartJournal.cs" Link="BlueprintConstructionPartJournal.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintConstructionCancellationJournal.cs" Link="BlueprintConstructionCancellationJournal.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintConstructionPayoutJournal.cs" Link="BlueprintConstructionPayoutJournal.cs" />
    <Compile Include="..\..\src\BuildWorks\ExternalBlueprintLibrary.cs" Link="ExternalBlueprintLibrary.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintExchangeFormat.cs" Link="BlueprintExchangeFormat.cs" />
    <Compile Include="..\..\src\BuildWorks\PlanBuildExport.cs" Link="PlanBuildExport.cs" />
    <Compile Include="..\..\src\BuildWorks\ServerBlueprintLibrary.cs" Link="ServerBlueprintLibrary.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintServerProtocol.cs" Link="BlueprintServerProtocol.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintServerEndpoint.cs" Link="BlueprintServerEndpoint.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintServerClient.cs" Link="BlueprintServerClient.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintServerRuntime.cs" Link="BlueprintServerRuntime.cs" />
    <Compile Include="..\..\src\BuildWorks\BlueprintServerAuthority.cs" Link="BlueprintServerAuthority.cs" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="assembly_utils">
      <HintPath>$(ValheimManagedDir)\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ProfileRoot)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
